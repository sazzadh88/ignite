@section("styles")
    body {
        background: #0f172a;
        overflow-x: hidden;
    }
    .dash-layout { display: flex; min-height: 100vh; }
    .sidebar {
        width: 260px; background: rgba(15,23,42,0.95);
        border-right: 1px solid rgba(148,163,184,0.12);
        display: flex; flex-direction: column; padding: 1.5rem 0;
        position: fixed; top: 0; left: 0; bottom: 0; z-index: 10;
    }
    .sidebar .brand {
        font-size: .82rem; font-weight: 800; letter-spacing: .22em;
        background: linear-gradient(110deg, #818cf8, #c084fc 50%, #f472b6);
        -webkit-background-clip: text; background-clip: text;
        -webkit-text-fill-color: transparent;
        padding: 0 1.5rem; margin-bottom: 2rem;
    }
    .sidebar .nav-item {
        display: block; padding: .75rem 1.5rem; color: #94a3b8;
        text-decoration: none; font-size: .92rem; font-weight: 500;
        border-left: 3px solid transparent;
        transition: background .15s, color .15s, border-color .15s;
    }
    .sidebar .nav-item:hover { background: rgba(148,163,184,0.06); color: #e2e8f0; }
    .sidebar .nav-item.active {
        color: #818cf8; border-left-color: #818cf8;
        background: rgba(99,102,241,0.08);
    }
    .sidebar .nav-bottom { margin-top: auto; padding: 0 1.5rem; }
    .main-area { margin-left: 260px; flex: 1; display: flex; flex-direction: column; }
    .topbar {
        display: flex; align-items: center; justify-content: flex-end;
        padding: 1rem 2rem; gap: 1rem;
        border-bottom: 1px solid rgba(148,163,184,0.10);
        background: rgba(15,23,42,0.6); backdrop-filter: blur(10px);
    }
    .topbar .user-name { color: #cbd5e1; font-size: .9rem; font-weight: 500; }
    .topbar .btn-logout {
        padding: .5rem 1rem; border: 1px solid rgba(148,163,184,0.2);
        border-radius: 8px; background: transparent; color: #94a3b8;
        font-size: .82rem; cursor: pointer; transition: background .15s, color .15s;
    }
    .topbar .btn-logout:hover { background: rgba(239,68,68,0.12); color: #fca5a5; border-color: rgba(239,68,68,0.35); }
    .content { padding: 2.5rem 2rem; flex: 1; }
    .page-title { font-size: 1.6rem; color: #f1f5f9; margin-bottom: .3rem; letter-spacing: -0.02em; }
    .page-title .highlight { color: #818cf8; }
    .page-sub { color: #94a3b8; font-size: .95rem; margin-bottom: 2rem; }
    .stats-grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); margin-bottom: 2.5rem; }
    .stat-card {
        display: flex; align-items: center; gap: 1rem; padding: 1.3rem 1.4rem;
        background: rgba(148,163,184,0.05); border: 1px solid rgba(148,163,184,0.14);
        border-radius: 14px; transition: transform .15s, border-color .2s;
    }
    .stat-card:hover { transform: translateY(-2px); border-color: rgba(129,140,248,0.4); }
    .stat-icon { font-size: 1.6rem; }
    .stat-info { display: flex; flex-direction: column; }
    .stat-label { font-size: .78rem; color: #64748b; text-transform: uppercase; letter-spacing: .06em; }
    .stat-value { font-size: .95rem; color: #e2e8f0; font-weight: 600; margin-top: .15rem; }
    .stat-ok { color: #34d399; }
    .quick-actions { margin-top: 1rem; }
    .quick-actions h2 { font-size: 1.1rem; color: #f1f5f9; margin-bottom: 1rem; }
    .actions-row { display: flex; gap: 1rem; flex-wrap: wrap; }
    .action-btn {
        padding: .7rem 1.4rem; border-radius: 10px; font-size: .9rem; font-weight: 600;
        text-decoration: none; color: #e2e8f0;
        background: rgba(148,163,184,0.06); border: 1px solid rgba(148,163,184,0.18);
        transition: background .15s, border-color .15s, transform .12s;
    }
    .action-btn:hover { background: rgba(99,102,241,0.12); border-color: rgba(99,102,241,0.4); transform: translateY(-1px); }
    @media (max-width: 768px) {
        .sidebar { width: 200px; }
        .main-area { margin-left: 200px; }
        .content { padding: 1.5rem 1rem; }
    }
@endsection

