        position: fixed; top: 0; left: 0; bottom: 0; z-index: 10;
    }
    .sidebar .brand {
        font-size: .82rem; font-weight: 800; letter-spacing: .22em;
        background: linear-gradient(110deg, #818cf8, #c084fc 50%, #f472b6);
