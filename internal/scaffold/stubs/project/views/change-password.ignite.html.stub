    }
    .sidebar .nav-item:hover { background: rgba(148,163,184,0.06); color: #e2e8f0; }
    .sidebar .nav-item.active {
        color: #818cf8; border-left-color: #818cf8;
        background: rgba(99,102,241,0.08);
    }
    .sidebar .nav-bottom { margin-top: auto; padding: 0 1.5rem; }
    .main-area { margin-left: 260px; flex: 1; display: flex; flex-direction: column; }
    .topbar {
        display: flex; align-items: center; justify-content: flex-end;
        padding: 1rem 2rem; gap: 1rem;
        border-bottom: 1px solid rgba(148,163,184,0.10);
        background: rgba(15,23,42,0.6); backdrop-filter: blur(10px);
    }
    .topbar .user-name { color: #cbd5e1; font-size: .9rem; font-weight: 500; }
    .topbar .btn-logout {
        padding: .5rem 1rem; border: 1px solid rgba(148,163,184,0.2);
        border-radius: 8px; background: transparent; color: #94a3b8;
        font-size: .82rem; cursor: pointer; transition: background .15s, color .15s;
    }
    .topbar .btn-logout:hover { background: rgba(239,68,68,0.12); color: #fca5a5; border-color: rgba(239,68,68,0.35); }
    .content { padding: 2.5rem 2rem; flex: 1; }
    .page-title { font-size: 1.6rem; color: #f1f5f9; margin-bottom: .3rem; letter-spacing: -0.02em; }
    .page-title .highlight { color: #818cf8; }
    .page-sub { color: #94a3b8; font-size: .95rem; margin-bottom: 2rem; }
    .form-section {
        max-width: 520px; padding: 2rem;
        background: rgba(148,163,184,0.04); border: 1px solid rgba(148,163,184,0.12);
        border-radius: 16px;
    }
    .field { margin-bottom: 1.1rem; }
    .field label { display: block; font-size: .82rem; color: #94a3b8; margin-bottom: .4rem; font-weight: 500; }
    .field input {
        width: 100%; padding: .8rem .95rem;
        background: rgba(148,163,184,0.06); border: 1px solid rgba(148,163,184,0.18);
        border-radius: 10px; color: #e2e8f0; font-size: .93rem; outline: none;
        transition: border-color .15s, box-shadow .15s;
    }
    .field input::placeholder { color: #64748b; }
    .field input:focus { border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99,102,241,0.22); }
    .btn-primary {
        padding: .8rem 1.6rem; border: 0; border-radius: 10px;
        font-size: .95rem; font-weight: 650; color: #fff; cursor: pointer;
        background: linear-gradient(120deg, #6366f1, #a855f7);
        box-shadow: 0 10px 30px -10px rgba(124,58,237,0.55);
        transition: transform .15s, box-shadow .2s;
    }
    .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 14px 35px -10px rgba(124,58,237,0.7); }
    .err { background: rgba(239,68,68,0.12); border: 1px solid rgba(239,68,68,0.35);
        color: #fca5a5; padding: .7rem .9rem; border-radius: 10px; font-size: .85rem; margin-bottom: 1.1rem; }
    .success { background: rgba(16,185,129,0.12); border: 1px solid rgba(16,185,129,0.35);
        color: #6ee7b7; padding: .7rem .9rem; border-radius: 10px; font-size: .85rem; margin-bottom: 1.1rem; }
    @media (max-width: 768px) {
        .sidebar { width: 200px; }
        .main-area { margin-left: 200px; }
        .content { padding: 1.5rem 1rem; }
